{
  "name": "brainydigital/intima.ai-sdk-php",
  "version": "1.1.0",
  "description": "Implementação da API do Intima.ai em forma de SDK Client para PHP.",
  "keywords": [
    "intimai",
    "intimaai",
    "intima.ai",
    "php",
    "sdk",
    "api"
  ],
  "homepage": "https://github.com/brainydigital/intima.ai-sdk-php-v3",
  "type": "library",
  "source": {
    "type": "git",
    "url": "https://github.com/brainydigital/intima.ai-sdk-php-v3.git",
    "reference": "main"
  },
  "support": {
    "issues": "https://github.com/brainydigital/intima.ai-sdk-php-v3/issues",
    "source": "https://github.com/brainydigital/intima.ai-sdk-php-v3"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "BrainyDigital",
      "email": "contato@brainydigital.com.br",
      "homepage": "https://intima.ai"
    }
  ],
  "require": {
    "php": "^8.2",
    "guzzlehttp/guzzle": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "Intimai\\": "lib/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload-dev": {
    "psr-4": {
      "Intimai\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
